{
  "name": "agent-pay-demo",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent with a Privy wallet and spending policy that pays a Stripe-backed API over MPP, plus an eval harness.",
  "type": "module",
  "scripts": {
    "server": "tsx server/index.ts",
    "agent": "tsx agent/run.ts",
    "view": "tsx view/index.ts",
    "validate": "npx mppx@latest validate http://localhost:4242",
    "typecheck": "tsc --noEmit",
    "check:stripe": "tsx scripts/check-stripe.ts",
    "wallet:create": "tsx scripts/create-wallet.ts",
    "wallet:fund": "tsx scripts/fund-wallet.ts",
    "policy:create": "tsx scripts/create-policy.ts",
    "check:policy": "tsx scripts/check-policy.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@privy-io/node": "^0.38.0",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "mppx": "^0.18.0",
    "stripe": "^23.1.0",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
